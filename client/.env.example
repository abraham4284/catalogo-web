# Las variables VITE_* son públicas en el navegador. No incluir secretos.
# Prefijo público completo, incluyendo /api/public (sin /catalog).
# Ejemplo conceptual: https://backend.example.com/api/public
VITE_CATALOG_API_URL=

# Contacto público (no es un secreto): código de país + número, 8–15 dígitos.
# Sin +, espacios ni guiones. Ejemplo documental: 5493811234567.
# Dejar vacío hasta definir el contacto real; no se usa un número por defecto.
VITE_WHATSAPP_NUMBER=

# Público, opcional. Vacío deshabilita Meta incluso si se acepta consentimiento.
# Producción: VITE_META_PIXEL_ID=1149384361363794 (requiere nuevo build).
VITE_META_PIXEL_ID=
